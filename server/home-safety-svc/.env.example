# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_TOPIC_FALL=fall/detected
MQTT_QOS=0
MQTT_RETAIN=false
# MQTT_USER=
# MQTT_PASS=

# Stream
SAFETY_STREAM=safety_events

# Hazard
HAZARD_LEVEL_THRESHOLD=50

# Inactivity (HS4)
INACTIVITY_MINUTES=30
INACTIVITY_SILENT_RANGE="22:00-06:00"

# Entry
AWAY_MODE=false

# Notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN_SEC=10
NOTIFY_RETRY=3

# --- DORA unified defaults (append-only, local scripts will override to 127.0.0.1) ---
# MQTT_HOST=mosquitto
# MQTT_PORT=1883
# REDIS_HOST=redis
# REDIS_PORT=6379
# SAFETY_STREAM=safety_events
# NOTIFY_COOLDOWN_SEC=10
