# Connectivity
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_KEEPALIVE=60

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Storage
VITALS_STREAM=vitals
SAFETY_STREAM=safety_events

# Crypto (32-byte key; base64 or hex). When empty, data is stored as plaintext envelope.
HM_AES_KEY=

# Thresholds for critical alerts
HM_THRESH_HR_MAX=120
HM_THRESH_SPO2_MIN=90
HM_THRESH_GLUCOSE_MAX=180

# Scheduler: periodic reminder
HM_REMINDER_INTERVAL_MIN=10
HM_REMINDER_METRICS=hr,spo2,glucose
HM_MAX_AGE_DEFAULT_MIN=180
# Optional per-metric override examples:
# HM_MAX_AGE_HR_MIN=120
# HM_MAX_AGE_SPO2_MIN=120
# HM_MAX_AGE_GLUCOSE_MIN=240

# Scheduler: daily summary
HM_DAILY_SUMMARY_AT=21:00
# Dev override (run summary every N minutes when >0):
HM_DAILY_SUMMARY_EVERY_MIN=0

# Feature switches (mostly for tests)
START_SUBSCRIBER=true
START_SCHEDULER=true

# --- DORA unified defaults (append-only, local scripts will override to 127.0.0.1) ---
# MQTT_HOST=mosquitto
# MQTT_PORT=1883
# REDIS_HOST=redis
# REDIS_PORT=6379
# VITALS_STREAM=vitals
# HM_AES_KEY=   # 32-byte base64 or hex; leave empty for plaintext
# NOTIFY_COOLDOWN_SEC=10
