# ===== DORA project Makefile (full replacement) =====
# 使用 '>' 作为配方前缀；如需改回 TAB，请删除下一行并把每行前缀 '>' 改成 TAB

SHELL := /bin/bash

# ---- Compose file sets ----
COMPOSE_HS_HM = -f ops/compose/docker-compose.dev.yml \
                -f ops/compose/docker-compose.mqtt.yml \
                -f ops/compose/docker-compose.hm.yml \
                -f ops/compose/docker-compose.hs.yml

COMPOSE_TV_TA = -f ops/compose/docker-compose.mqtt.yml \
                -f ops/compose/docker-compose.tv.yml \
                -f ops/compose/docker-compose.ta.yml

COMPOSE_ALL   = $(COMPOSE_HS_HM) \
                -f ops/compose/docker-compose.tv.yml \
                -f ops/compose/docker-compose.ta.yml

# ---- Helpers ----
define WAIT_HTTP
bash -lc 'for i in {1..60}; do \
  curl -sf "$(1)" >/dev/null && { echo "[ok] $(1)"; exit 0; } || sleep 1; \
done; echo "[timeout] $(1)"; exit 1'
endef

.PHONY: help
help:
	@echo "Targets:"
	@echo "  make up-core         # 启动 Redis/MQTT + HS/HM 两个服务，并等待就绪"
	@echo "  make down            # 关闭所有（HS/HM/TV/TA）并清理卷"
	@echo "  make logs-hs|logs-hm # 跟随日志"
	@echo "  make ping-hs|ping-hm # 健康检查"
	@echo "  make up-tv-ta        # 启动 TV + Tele-Assist，并等待就绪"
	@echo "  make down-tv-ta      # 关闭 TV + Tele-Assist"
	@echo "  make logs-tv|logs-ta # 跟随 TV/TA 日志"
	@echo "  make ping-tv|ping-ta # /ping 健康检查"
	@echo "  make open-tv|open-ta # 打开浏览器到静态页（带 ?room=demo）"

# ===================== HS / HM ======================

.PHONY: up-core
up-core:
	docker compose $(COMPOSE_HS_HM) up -d redis mosquitto
	echo "[core] waiting mosquitto on 127.0.0.1:1883 ..."
	bash -lc 'for i in {1..30}; do (echo >/dev/tcp/127.0.0.1/1883) >/dev/null 2>&1 && { echo ok; break; } || sleep 1; done'
	docker compose $(COMPOSE_HS_HM) up -d home-safety-svc health-svc
	$(call WAIT_HTTP,http://127.0.0.1:8000/ping)
	$(call WAIT_HTTP,http://127.0.0.1:8100/ping)
	echo "HS/HM READY ->"
	echo "  HS: http://127.0.0.1:8000/health/ready"
	echo "  HM: http://127.0.0.1:8100/health/ready"

.PHONY: logs-hs logs-hm
logs-hs:
	docker compose $(COMPOSE_HS_HM) logs -f home-safety-svc
logs-hm:
	docker compose $(COMPOSE_HS_HM) logs -f health-svc

.PHONY: ping-hs ping-hm
ping-hs:
	curl -s http://127.0.0.1:8000/ping && echo
ping-hm:
	curl -s http://127.0.0.1:8100/ping && echo

# ===================== TV / TA ======================

.PHONY: up-tv-ta
up-tv-ta:
	docker compose $(COMPOSE_TV_TA) up -d tv-svc tele-assist-svc
	$(call WAIT_HTTP,http://127.0.0.1:8200/ping)
	$(call WAIT_HTTP,http://127.0.0.1:8300/ping)
	echo "TV/TA READY ->"
	echo "  TV: http://127.0.0.1:8200/static/index.html?room=demo"
	echo "  TA: http://127.0.0.1:8300/static/index.html?room=demo"

.PHONY: logs-tv logs-ta
logs-tv:
	docker compose $(COMPOSE_TV_TA) logs -f tv-svc
logs-ta:
	docker compose $(COMPOSE_TV_TA) logs -f tele-assist-svc

.PHONY: ping-tv ping-ta
ping-tv:
	curl -s http://127.0.0.1:8200/ping && echo
ping-ta:
	curl -s http://127.0.0.1:8300/ping && echo

.PHONY: open-tv open-ta
open-tv:
	python - <<'PY'
import webbrowser; webbrowser.open("http://127.0.0.1:8200/static/index.html?room=demo")
PY
open-ta:
	python - <<'PY'
import webbrowser; webbrowser.open("http://127.0.0.1:8300/static/index.html?room=demo")
PY

# ===================== ALL ======================

.PHONY: down
down:
	docker compose $(COMPOSE_ALL) down -v

.PHONY: logs-all
logs-all:
	docker compose $(COMPOSE_ALL) logs -f

.PHONY: ps
ps:
	docker compose $(COMPOSE_ALL) ps
