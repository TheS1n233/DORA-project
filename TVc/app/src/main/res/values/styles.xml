<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== 应用主题：一定要在 Manifest 里引用它 ===== -->
    <style name="Theme.TvApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 首帧就用你的浅色背景，避免黑屏 -->
        <item name="android:windowBackground">@color/dora_bg</item>
        <!-- 开启硬件加速（默认就是 true，这里显式声明更直观） -->
        <item name="android:hardwareAccelerated">true</item>
        <!-- 关掉启动预览窗口，减少“黑一闪”的感觉 -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- ===== 你原来的文字/块样式（保留） ===== -->
    <style name="DoraTitle">
        <item name="android:textColor">@color/dora_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="DoraMuted">
        <item name="android:textColor">@color/dora_muted</item>
    </style>

    <style name="DoraDayCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/dora_muted</item>
    </style>

    <style name="DoraDateCell">

            <item name="android:layout_width">match_parent</item>
            <item name="android:layout_height">wrap_content</item>
            <item name="android:gravity">center_vertical</item>
            <item name="android:paddingLeft">8dp</item>
            <item name="android:paddingRight">8dp</item>
            <item name="android:background">@drawable/bg_card</item>
            <item name="android:textColor">@color/dora_text</item>
            <item name="android:layout_marginBottom">4dp</item> <!-- 原 8dp → 4dp -->

    </style>
    <style name="MetricTitle">
        <item name="android:textColor">@color/dora_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MetricValue">
        <item name="android:textColor">@color/dora_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="MetricUnit">
        <item name="android:textColor">@color/dora_muted</item>
        <item name="android:textSize">12sp</item>
    </style>


    <style name="DoraScheduleItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <!-- 改为 Start/End，避免 Lint 警告 -->
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:textColor">@color/dora_text</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

</resources>
