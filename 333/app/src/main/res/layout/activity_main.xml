<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dora_bg">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ScrollView 里唯一的直接子元素 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 顶部信息条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DORA"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:textColor="@color/dora_text"/>

                <Space android:layout_width="16dp" android:layout_height="1dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search"
                        style="@style/DoraMuted"/>
                </LinearLayout>

                <Space android:layout_width="12dp" android:layout_height="1dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔"
                    android:textSize="20sp"
                    android:padding="4dp"/>

                <Space android:layout_width="8dp" android:layout_height="1dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Caregiver"
                    android:textStyle="bold"
                    android:textColor="@color/dora_text"/>
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="20dp"/>

            <!-- 第一行：Home status + Health + Calendar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Home status -->
                <LinearLayout
                    android:id="@+id/cardHome"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:focusable="true"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/DoraTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home status"/>

                    <Space android:layout_width="match_parent" android:layout_height="8dp"/>
                    <!-- 三块：温度 / 湿度 / 燃气 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="3"
                        android:orientation="horizontal">
                        <!-- 温度 -->
                        <LinearLayout
                            android:id="@+id/tileTemp"
                            android:layout_width="0dp"
                            android:layout_height="88dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_metric_chip"
                            android:padding="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:text="●"
                                android:textSize="12sp"
                                android:textColor="@color/dora_accent"
                                android:contentDescription="@string/cd_temp"/>

                            <Space android:layout_width="8dp" android:layout_height="1dp"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/MetricTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Temperature"/>

                            </LinearLayout>

                        </LinearLayout>

                        </LinearLayout>


                </LinearLayout>

                <Space android:layout_width="16dp" android:layout_height="1dp"/>

                <!-- 健康诊断 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:focusable="true"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/DoraTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Person's  Health"/>

                    <Space android:layout_width="match_parent" android:layout_height="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgHuman"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center_vertical"
                            android:adjustViewBounds="true"
                            android:scaleType="fitStart"
                            android:src="@drawable/ren1" />

                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/metricHeart"
                                style="@style/DoraScheduleItem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/dora_badge_orange"
                                android:text="Glucose 12ml/dl"/>

                            <TextView
                                android:id="@+id/metricLungs"
                                style="@style/DoraScheduleItem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/dora_badge_blue"
                                android:text="Temperature 12℃"/>

                            <TextView
                                android:id="@+id/metricStomach"
                                style="@style/DoraScheduleItem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/dora_badge_pink"
                                android:text="Oxygen Saturation 12%"/>

                            <TextView
                                android:id="@+id/metricLiver"
                                style="@style/DoraScheduleItem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/dora_badge_blue"
                                android:text="Sleep Quality 12h"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <Space android:layout_width="16dp" android:layout_height="1dp"/>

                <!-- 日历（周一行） + 今日行程 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:focusable="true"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMonthTitle"
                        style="@style/DoraTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calendar" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/weekRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:overScrollMode="never" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="8dp" />

                    <TextView
                        style="@style/DoraScheduleItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/dora_badge_orange"
                        android:text="08:00 – Dentist" />

                    <TextView
                        style="@style/DoraScheduleItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/dora_badge_blue"
                        android:text="09:30 – Neurologist" />

                    <TextView
                        style="@style/DoraScheduleItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/dora_badge_pink"
                        android:text="18:00 – X-Ray" />
                </LinearLayout>
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="16dp"/>

            <!-- 第二行：Blood pressure + Your activity + Heart rate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 血压趋势（占位） -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:focusable="true"
                    android:padding="12dp"
                    android:orientation="vertical">
                    <TextView
                        style="@style/DoraTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blood pressure"/>
                    <Space android:layout_width="match_parent" android:layout_height="8dp"/>
                    <TextView
                        android:id="@+id/bpChart"
                        style="@style/DoraMuted"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="(chart)"/>
                </LinearLayout>

                <Space android:layout_width="16dp" android:layout_height="1dp"/>

                <!-- 活动柱状（占位） -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:focusable="true"
                    android:padding="12dp"
                    android:orientation="vertical">
                    <TextView
                        style="@style/DoraTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your activity"/>
                    <Space android:layout_width="match_parent" android:layout_height="8dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@color/dora_accent"/>
                        <Space android:layout_width="4dp" android:layout_height="1dp"/>
                        <View android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:background="@color/dora_accent"/>
                        <Space android:layout_width="4dp" android:layout_height="1dp"/>
                        <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@color/dora_accent"/>
                        <Space android:layout_width="4dp" android:layout_height="1dp"/>
                        <View android:layout_width="0dp" android:layout_height="85dp" android:layout_weight="1" android:background="@color/dora_accent"/>
                        <Space android:layout_width="4dp" android:layout_height="1dp"/>
                        <View android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:background="@color/dora_accent"/>
                        <Space android:layout_width="4dp" android:layout_height="1dp"/>
                        <View android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:background="@color/dora_accent"/>
                        <Space android:layout_width="4dp" android:layout_height="1dp"/>
                        <View android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:background="@color/dora_accent"/>
                    </LinearLayout>
                </LinearLayout>

                <Space android:layout_width="16dp" android:layout_height="1dp"/>

                <!-- 心率 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_selector"
                    android:focusable="true"
                    android:padding="12dp"
                    android:orientation="vertical">
                    <TextView
                        style="@style/DoraTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heart rate"/>
                    <Space android:layout_width="match_parent" android:layout_height="12dp"/>
                    <TextView
                        android:id="@+id/heartRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="102 bpm"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/dora_accent"/>
                </LinearLayout>
            </LinearLayout>

            <Space android:layout_width="match_parent" android:layout_height="24dp"/>

        </LinearLayout>  <!-- root LinearLayout 结束 -->
    </ScrollView>       <!-- ScrollView 结束 -->

</androidx.constraintlayout.widget.ConstraintLayout>
